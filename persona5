<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Persona 5 Royal</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: #000;
            color: #fff;
            font-family: Arial, sans-serif;
            overflow-x: hidden;
            cursor: none;
        }

       
        .cursor-dot {
            position: fixed;
            width: 8px;
            height: 8px;
            background: #ff0000;
            border-radius: 50%;
            pointer-events: none;
            z-index: 99999;
            transition: transform 0.1s ease;
            box-shadow: 0 0 10px rgba(255, 0, 0, 0.8);
        }

        .cursor-ring {
            position: fixed;
            width: 30px;
            height: 30px;
            border: 2px solid rgba(255, 0, 0, 0.5);
            border-radius: 50%;
            pointer-events: none;
            z-index: 99998;
            transition: transform 0.3s ease, border-color 0.3s ease;
        }

    
        .loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            z-index: 99999;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            animation: fadeOut 0.5s ease 2.5s forwards;
        }

        .loading-screen .p5-logo {
            font-size: 48px;
            font-weight: bold;
            color: #ff0000;
            letter-spacing: 8px;
            text-transform: uppercase;
            animation: logoAppear 1s ease forwards;
            text-shadow: 0 0 30px rgba(255, 0, 0, 0.5);
        }

        .loading-screen .loading-bar {
            width: 200px;
            height: 3px;
            background: rgba(255, 255, 255, 0.1);
            margin-top: 30px;
            position: relative;
            overflow: hidden;
            border-radius: 2px;
        }

        .loading-screen .loading-bar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #ff0000;
            animation: loadBar 2s ease forwards;
        }

        .loading-screen .loading-text {
            color: rgba(255, 255, 255, 0.3);
            font-size: 12px;
            margin-top: 15px;
            letter-spacing: 4px;
            text-transform: uppercase;
            animation: textBlink 0.5s ease infinite alternate;
        }

        @keyframes logoAppear {
            0% { opacity: 0; transform: translateY(-20px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        @keyframes loadBar {
            0% { width: 0%; }
            100% { width: 100%; }
        }

        @keyframes fadeOut {
            0% { opacity: 1; }
            100% { opacity: 0; pointer-events: none; visibility: hidden; }
        }

        @keyframes textBlink {
            0% { opacity: 0.3; }
            100% { opacity: 0.8; }
        }

       
        .pattern-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 3;
            opacity: 0.02;
            background-image: 
                repeating-linear-gradient(
                    45deg,
                    transparent,
                    transparent 10px,
                    rgba(255, 255, 255, 0.5) 10px,
                    rgba(255, 255, 255, 0.5) 11px
                );
        }

        
        .section-divider {
            position: relative;
            width: 80%;
            max-width: 800px;
            margin: 40px auto;
            height: 2px;
            background: linear-gradient(90deg, 
                transparent 0%, 
                rgba(255, 0, 0, 0.5) 20%, 
                #ff0000 50%, 
                rgba(255, 0, 0, 0.5) 80%, 
                transparent 100%);
        }

        .section-divider::before {
            content: '';
            position: absolute;
            top: -3px;
            left: 50%;
            transform: translateX(-50%);
            width: 8px;
            height: 8px;
            background: #ff0000;
            clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
            animation: dividerPulse 2s ease-in-out infinite;
        }

        @keyframes dividerPulse {
            0%, 100% { transform: translateX(-50%) scale(1); }
            50% { transform: translateX(-50%) scale(1.5); }
        }

      
        .side-indicator {
            position: fixed;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 60;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .indicator-dot {
            width: 8px;
            height: 8px;
            background: rgba(255, 0, 0, 0.3);
            clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .indicator-dot:hover {
            background: #ff0000;
            transform: scale(1.5);
            box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
        }

        .indicator-dot.active {
            background: #ff0000;
            animation: dotPulse 2s ease-in-out infinite;
        }

        @keyframes dotPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* === TORN PAPER EFFECT BORDER === */
        .torn-paper {
            position: relative;
            width: 100%;
            height: 20px;
            background: linear-gradient(180deg, 
                rgba(255, 0, 0, 0.1) 0%, 
                transparent 100%);
            clip-path: polygon(
                0% 0%, 2% 100%, 5% 0%, 8% 100%, 11% 0%, 14% 100%, 17% 0%, 20% 100%,
                23% 0%, 26% 100%, 29% 0%, 32% 100%, 35% 0%, 38% 100%, 41% 0%, 44% 100%,
                47% 0%, 50% 100%, 53% 0%, 56% 100%, 59% 0%, 62% 100%, 65% 0%, 68% 100%,
                71% 0%, 74% 100%, 77% 0%, 80% 100%, 83% 0%, 86% 100%, 89% 0%, 92% 100%,
                95% 0%, 98% 100%, 100% 0%
            );
            animation: tornPaperWave 4s ease-in-out infinite;
        }

        @keyframes tornPaperWave {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }

       
        .final-cta-section {
            position: relative;
            width: 100%;
            padding: 100px 0 80px;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 50;
        }

        .final-cta-btn {
            position: relative;
            cursor: pointer;
            transition: all 0.4s ease;
            display: inline-block;
            border: 4px solid #ff0000;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 
                0 0 20px rgba(255, 0, 0, 0.4),
                0 0 40px rgba(255, 0, 0, 0.2),
                inset 0 0 20px rgba(255, 0, 0, 0.1);
            text-decoration: none;
        }

        .final-cta-btn::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            border: 2px solid rgba(255, 0, 0, 0.6);
            border-radius: 14px;
            animation: ctaBorderPulse 2s ease-in-out infinite;
            z-index: -1;
        }

        .final-cta-btn::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(ellipse at center, rgba(255, 0, 0, 0.1) 0%, transparent 70%);
            z-index: -1;
            animation: ctaGlow 2s ease-in-out infinite alternate;
        }

        .final-cta-btn:hover {
            transform: scale(1.05) translateY(-8px);
            box-shadow: 
                0 0 40px rgba(255, 0, 0, 0.6),
                0 0 80px rgba(255, 0, 0, 0.3),
                inset 0 0 30px rgba(255, 0, 0, 0.2);
            border-color: #ff3333;
        }

        .final-cta-btn:hover::before {
            border-color: rgba(255, 0, 0, 1);
        }

        .final-cta-btn img {
            width: 450px;
            height: auto;
            display: block;
            border-radius: 8px;
        }

        @keyframes ctaBorderPulse {
            0%, 100% { opacity: 0.6; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.02); }
        }

        @keyframes ctaGlow {
            0% { opacity: 0.3; transform: scale(1); }
            100% { opacity: 0.6; transform: scale(1.05); }
        }

        /* === FOOTER === */
        .page-footer {
            position: relative;
            width: 100%;
            padding: 30px 0;
            text-align: center;
            z-index: 50;
        }

        .page-footer p {
            color: rgba(255, 255, 255, 0.2);
            font-size: 11px;
            letter-spacing: 2px;
        }

       
        .main-container {
            width: 100%;
            min-width: 1400px;
            height: 4222px;
            position: relative;
            overflow: hidden;
        }

        .black-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            z-index: 0;
        }

        .red-top-gradient {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .red-top-gradient::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 50%;
            background: linear-gradient(
                180deg,
                rgba(200, 0, 0, 0.35) 0%,
                rgba(180, 0, 0, 0.2) 8%,
                rgba(140, 0, 0, 0.1) 18%,
                rgba(100, 0, 0, 0.04) 30%,
                rgba(60, 0, 0, 0.01) 42%,
                transparent 55%
            );
            animation: shimmerPulse 6s ease-in-out infinite;
        }

        .red-top-gradient::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 45%;
            background:
                radial-gradient(ellipse at 50% 0%, rgba(255, 30, 0, 0.35) 0%, transparent 50%),
                radial-gradient(ellipse at 25% 5%, rgba(200, 15, 0, 0.2) 0%, transparent 40%),
                radial-gradient(ellipse at 75% 8%, rgba(180, 10, 0, 0.18) 0%, transparent 35%),
                radial-gradient(ellipse at 50% 12%, rgba(160, 8, 0, 0.12) 0%, transparent 30%),
                radial-gradient(ellipse at 40% 3%, rgba(220, 25, 0, 0.25) 0%, transparent 28%);
            animation: shimmerGlow 8s ease-in-out infinite alternate;
        }

        .shimmer-layer {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 35%;
            pointer-events: none;
            z-index: 2;
            overflow: hidden;
        }

        .shimmer-layer::before {
            content: '';
            position: absolute;
            top: -10%;
            left: -50%;
            width: 200%;
            height: 100%;
            background: linear-gradient(
                180deg,
                transparent 0%,
                rgba(255, 50, 0, 0.06) 25%,
                rgba(255, 35, 0, 0.1) 50%,
                rgba(255, 50, 0, 0.06) 75%,
                transparent 100%
            );
            animation: shimmerSlide 10s ease-in-out infinite;
        }

        .shimmer-layer::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background:
                radial-gradient(2px 2px at 20% 8%, rgba(255, 80, 0, 0.35), transparent),
                radial-gradient(2px 2px at 45% 15%, rgba(255, 60, 0, 0.25), transparent),
                radial-gradient(1px 1px at 65% 5%, rgba(255, 100, 0, 0.3), transparent),
                radial-gradient(2px 2px at 85% 12%, rgba(255, 50, 0, 0.25), transparent),
                radial-gradient(1px 1px at 10% 20%, rgba(255, 70, 0, 0.2), transparent),
                radial-gradient(2px 2px at 55% 25%, rgba(255, 90, 0, 0.25), transparent),
                radial-gradient(1px 1px at 78% 18%, rgba(255, 60, 0, 0.22), transparent),
                radial-gradient(2px 2px at 92% 8%, rgba(255, 80, 0, 0.28), transparent),
                radial-gradient(1px 1px at 35% 3%, rgba(255, 75, 0, 0.2), transparent),
                radial-gradient(2px 2px at 50% 28%, rgba(255, 55, 0, 0.18), transparent);
            animation: particlesFloat 7s ease-in-out infinite alternate;
        }

        .noise-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.03;
            background-image: url("image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 3;
        }

       
        .top-right-icon {
            position: fixed;
            top: 12px;
            right: 12px;
            width: 42px;
            height: 42px;
            z-index: 50;
            cursor: pointer;
            opacity: 0.85;
            transition: opacity 0.3s ease, transform 0.3s ease;
            text-decoration: none;
        }

        .top-right-icon:hover {
            opacity: 1;
            transform: scale(1.15);
        }

        .top-right-icon img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        /* === HERO / BANNER SECTION === */
        .hero-section {
            position: relative;
            width: 100%;
            z-index: 5;
            padding-top: 20px;
        }

        .hero-banner {
            position: relative;
            width: 94%;
            max-width: 1200px;
            margin: 0 auto;
            border-radius: 12px;
            overflow: visible;
            border: 3px solid #ff0000;
            box-shadow: 0 0 15px rgba(255, 0, 0, 0.3);
        }

        .hero-banner img.main-banner-img {
            width: 100%;
            height: auto;
            display: block;
            border-radius: 12px;
        }

       
        .banner-corner-icon {
            position: absolute;
            bottom: -20px;
            right: -20px;
            width: 100px;
            height: auto;
            z-index: 20;
            opacity: 0.95;
            transition: opacity 0.3s, transform 0.3s;
            filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.8));
        }

        .banner-corner-icon:hover {
            opacity: 1;
            transform: scale(1.1) rotate(2deg);
        }

        .hero-banner::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 30%;
            background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.6));
            pointer-events: none;
            border-radius: 0 0 12px 12px;
        }

       
        .nav-bar {
            position: relative;
            width: 96%;
            max-width: 1200px;
            margin: 20px auto 0;
            padding: 18px 30px;
            background: linear-gradient(180deg, rgba(70, 25, 25, 0.95) 0%, rgba(50, 15, 15, 0.95) 100%);
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            z-index: 5;
            display: flex;
            justify-content: space-around;
            align-items: center;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: transform 0.3s ease, filter 0.3s ease;
            padding: 8px 12px;
            text-decoration: none;
        }

        .nav-item:hover {
            transform: translateY(-4px);
            filter: brightness(1.3);
        }

        .nav-icon {
            width: 76px;
            height: 76px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav-icon img {
             width: 147px;
            height: 100%;
            object-fit: contain;
        }

        .nav-label {
            font-size: 11px;
            color: #ff3333;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            text-shadow: 
                2px 2px 0 #000,
                -1px -1px 0 #000,
                1px -1px 0 #000,
                -1px 1px 0 #000,
                0 0 8px rgba(255, 0, 0, 0.5);
        }

        .nav-label-img {
            width: 95px;
            height: auto;
        }

        
        .nav-item:last-child .nav-icon {
            width: 80px;
            height: 80px;
        }

        .nav-item:last-child .nav-label-img {
            width: 147px;
        }

        
        .characters-section {
            position: relative;
            width: 200%;
            max-width: 500px;
            margin: 80px auto;
            z-index: 5;
        }

        .characters-section img.main-chars {
            bottom: -1000px;
            left: 80%;
            transform: translateX(-70%);
            width: 600px;
            height: auto;
            z-index: 20;
        }

        
        .animated-banner {
            position: absolute;
            bottom: -1000px;
            left: 50%;
            transform: translateX(-50%);
            width: 1450px;
            height: auto;
            z-index: 20;
            animation: bouncePulse 3s ease-in-out infinite;
        }

        @keyframes bouncePulse {
            0% { transform: translateX(-50%) scale(1); }
            50% { transform: translateX(-50%) scale(1.05); }
            100% { transform: translateX(-50%) scale(1); }
        }

        
        .char-top-right-icon {
            position: absolute;
            top: 60px;
            left: 150%;
            transform: translateX(-50%);
            width: 320px;
            height: auto;
            z-index: 15;
        }

        
        .download-section {
            position: relative;
            z-index: 50;
            text-align: center;
            margin: 1100px auto 0;
            pointer-events: none;
        }
        
        .download-section img {
            pointer-events: auto;
            width: 500px;
            height: auto;
            cursor: pointer;
            transition: transform 0.3s ease, filter 0.3s ease;
        }

        .download-section img:hover {
            transform: translateY(-5px) scale(1.05);
            filter: brightness(1.3) drop-shadow(0 0 20px rgba(255, 0, 0, 0.8));
        }

        
        .brightened-image {
            width: 2000px;
            height: 50%;
            display: block;
            margin: -460px auto;
            filter: brightness(100%);
            position: relative;
            z-index: 0;
        }

        @keyframes downloadPulse {
            0% { transform: translateY(-8px) scale(1.05); }
            50% { transform: translateY(-12px) scale(1.08); }
            100% { transform: translateY(-8px) scale(1.05); }
        }

        @keyframes shimmerPulse {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }

        @keyframes shimmerGlow {
            0% { opacity: 0.4; transform: scale(1); }
            100% { opacity: 0.7; transform: scale(1.03); }
        }

        @keyframes shimmerSlide {
            0% { transform: translateY(-10px); opacity: 0.3; }
            50% { transform: translateY(50px); opacity: 0.7; }
            100% { transform: translateY(-10px); opacity: 0.3; }
        }

        @keyframes particlesFloat {
            0% { transform: translateY(0px); opacity: 0.5; }
            100% { transform: translateY(12px); opacity: 0.8; }
        }
    </style>
</head>
